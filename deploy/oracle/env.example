# UPG Monitor environment. install.sh fills the __PLACEHOLDERS__ and writes
# /opt/upgsuptime/.env (mode 600). Restart after editing: sudo systemctl restart upgsuptime

# Public HTTPS URL, exactly as users open it (no trailing slash).
NEXTAUTH_URL=https://__DOMAIN__
# Session signing key. Never share it; changing it signs everyone out.
NEXTAUTH_SECRET=__NEXTAUTH_SECRET__
# Only needed for an external cron hitting /api/cron/run-checks; the app schedules checks itself.
CRON_SECRET=__CRON_SECRET__

# SQLite database file (backed up daily by upgsuptime-backup.timer).
DATABASE_URL=file:__DATA_DIR__/uptime.db

# Shown as "Checks from …" in the dashboard, e.g. "Oracle Cloud · São Paulo".
# CHECKS_LOCATION=

# After creating your admin account you can block new setups:
# DISABLE_SETUP=true

# Email alerts (optional). Without SMTP_HOST no emails are sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="UPG Monitor <alerts@example.com>"
