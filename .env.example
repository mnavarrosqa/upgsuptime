# Copy to .env for local development:  cp .env.example .env
# These are DEV-ONLY defaults. Never use them in production — set real secrets there.

# --- Auth (NextAuth) ---
# Any non-empty string works for local dev. Generate a strong value for production:
#   openssl rand -hex 32
NEXTAUTH_SECRET=dev-only-nextauth-secret-change-me
# The URL the app is opened at (no trailing slash). Use your real HTTPS URL in production.
NEXTAUTH_URL=http://localhost:3077

# --- Cron endpoint protection ---
# Required for POST/GET /api/cron/run-checks to be accepted.
CRON_SECRET=dev-only-cron-secret-change-me

# --- Email acknowledgement signing (down-alert ack links) ---
# Falls back to NEXTAUTH_SECRET when unset.
EMAIL_ACK_SECRET=dev-only-email-ack-secret-change-me

# --- Database (local SQLite file) ---
DATABASE_URL=file:./uptime.db

# --- Remote development ---
# Comma-separated hosts/IPs allowed to open the dev server (localhost is always allowed).
# ALLOWED_DEV_ORIGINS=localhost:3077

# --- Optional: SMTP for outbound email notifications ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="UPG Monitor <no-reply@example.com>"
